target_compile_definitions(${CMAKE_PROJECT_NAME} PRIVATE CLOCK_OTA_ENABLED=$<BOOL:${CLOCK_OTA_ENABLED}>)
target_link_options(${CMAKE_PROJECT_NAME} PRIVATE "-Wl,-Map=${CMAKE_CURRENT_BINARY_DIR}/Clock_CubeMX.map")
if(NOT CLOCK_OTA_ENABLED)
    target_link_options(${CMAKE_PROJECT_NAME} PRIVATE "-T${CMAKE_SOURCE_DIR}/STM32F407xx_FLASH.ld")
    set_property(TARGET ${CMAKE_PROJECT_NAME} APPEND PROPERTY LINK_DEPENDS "${CMAKE_SOURCE_DIR}/STM32F407xx_FLASH.ld")
    return()
endif()
if(CLOCK_RGB_TEST)
    message(FATAL_ERROR "RGB smoke firmware is not an OTA application")
endif()
set(CLOCK_OTA_CONFIG_FILE "${CMAKE_SOURCE_DIR}/app/ota_config_local.h" CACHE FILEPATH "Private OTA config header")
if(NOT EXISTS "${CLOCK_OTA_CONFIG_FILE}")
    message(FATAL_ERROR "OTA requires a private config; run node tools/ota/ota.mjs init --help")
endif()
file(READ "${CLOCK_OTA_CONFIG_FILE}" OTA_CONFIG_CONTENT)
string(REGEX MATCH "#define[ \t]+CLOCK_OTA_KEY_HEX[ \t]+\"([0-9a-fA-F]+)\"" OTA_KEY_MATCH "${OTA_CONFIG_CONTENT}")
set(OTA_KEY_VALUE "${CMAKE_MATCH_1}")
string(LENGTH "${OTA_KEY_VALUE}" OTA_KEY_LENGTH)
if(NOT OTA_KEY_LENGTH EQUAL 64 OR OTA_KEY_VALUE MATCHES "^0+$")
    message(FATAL_ERROR "OTA release key must contain 32 nonzero bytes encoded as 64 hex characters")
endif()
foreach(OTA_FIELD HOST PATH)
    string(REGEX MATCH "#define[ \t]+CLOCK_OTA_${OTA_FIELD}[ \t]+\"([^\"]+)\"" OTA_FIELD_MATCH "${OTA_CONFIG_CONTENT}")
    if(NOT OTA_FIELD_MATCH)
        message(FATAL_ERROR "OTA requires a nonempty recovery host and package path")
    endif()
    set(OTA_${OTA_FIELD}_VALUE "${CMAKE_MATCH_1}")
endforeach()
string(LENGTH "${OTA_HOST_VALUE}" OTA_HOST_LENGTH)
if(OTA_HOST_LENGTH GREATER 64 OR NOT OTA_HOST_VALUE MATCHES "^[a-zA-Z0-9.-]+$")
    message(FATAL_ERROR "OTA recovery host must be an ASCII hostname/IPv4 address up to 64 bytes")
endif()
string(LENGTH "${OTA_PATH_VALUE}" OTA_PATH_LENGTH)
if(OTA_PATH_LENGTH GREATER 156 OR NOT OTA_PATH_VALUE MATCHES "^/[a-zA-Z0-9._/-]+$" OR
   OTA_PATH_VALUE MATCHES "//|/\\.\\.?(/|$)")
    message(FATAL_ERROR "OTA package path must be an ASCII path up to 156 bytes without queries or traversal")
endif()
foreach(OTA_FIELD PORT VERSION)
    string(REGEX MATCH "#define[ \t]+CLOCK_OTA_${OTA_FIELD}[ \t]+([0-9]+)" OTA_FIELD_MATCH "${OTA_CONFIG_CONTENT}")
    if(NOT OTA_FIELD_MATCH OR CMAKE_MATCH_1 LESS 1)
        message(FATAL_ERROR "OTA port/version must be positive integers")
    endif()
    set(OTA_${OTA_FIELD}_VALUE "${CMAKE_MATCH_1}")
endforeach()
if(OTA_PORT_VALUE GREATER 65535 OR OTA_VERSION_VALUE GREATER 4294967295)
    message(FATAL_ERROR "OTA port/version is out of range")
endif()
set(OTA_DISCOVERY_URL "http://${OTA_HOST_VALUE}:${OTA_PORT_VALUE}${OTA_PATH_VALUE}?latest=1")
string(LENGTH "${OTA_DISCOVERY_URL}" OTA_DISCOVERY_URL_LENGTH)
if(OTA_DISCOVERY_URL_LENGTH GREATER 224)
    message(FATAL_ERROR "OTA discovery URL must be at most 224 ASCII bytes for the 255-byte HTTPCGET command")
endif()
file(TO_CMAKE_PATH "${CLOCK_OTA_CONFIG_FILE}" OTA_CONFIG_INCLUDE)
set(OTA_COMMON
    BSP/OTA/ota_crypto.c BSP/OTA/ota_image.c BSP/OTA/ota_journal.c)
target_sources(${CMAKE_PROJECT_NAME} PRIVATE ${OTA_COMMON} BSP/OTA/ota_discovery.c)
target_compile_definitions(${CMAKE_PROJECT_NAME} PRIVATE CLOCK_OTA_CONFIG_HEADER="${OTA_CONFIG_INCLUDE}")
target_compile_definitions(STM32_Drivers PRIVATE USER_VECT_TAB_ADDRESS VECT_TAB_OFFSET=0x10000U)
target_link_options(${CMAKE_PROJECT_NAME} PRIVATE "-T${CMAKE_SOURCE_DIR}/bootloader/app.ld")
set_property(TARGET ${CMAKE_PROJECT_NAME} APPEND PROPERTY LINK_DEPENDS "${CMAKE_SOURCE_DIR}/bootloader/app.ld")
set(BOOT_HAL)
foreach(BOOT_DRIVER hal hal_cortex hal_gpio hal_rcc hal_rcc_ex hal_pwr hal_pwr_ex hal_uart hal_i2c hal_i2c_ex hal_dma)
    list(APPEND BOOT_HAL "Drivers/STM32F4xx_HAL_Driver/Src/stm32f4xx_${BOOT_DRIVER}.c")
endforeach()
add_executable(Clock_Bootloader
    bootloader/startup.s bootloader/main.c bootloader/boot_platform.c
    bootloader/boot_net.c bootloader/boot_uart.c bootloader/boot_policy.c bootloader/boot_target.c
    Core/Src/system_stm32f4xx.c ${BOOT_HAL} ${OTA_COMMON}
    BSP/OTA/ota_installer.c BSP/OTA/ota_http.c BSP/WiFi/wifi_store.c)
target_link_libraries(Clock_Bootloader PRIVATE stm32cubemx)
target_include_directories(Clock_Bootloader PRIVATE BSP/OTA BSP/WiFi app bootloader)
target_compile_options(Clock_Bootloader PRIVATE -Os -Wall -Wextra -Werror)
target_compile_definitions(Clock_Bootloader PRIVATE CLOCK_OTA_ENABLED=1 CLOCK_OTA_CONFIG_HEADER="${OTA_CONFIG_INCLUDE}")
if(EXISTS "${CMAKE_SOURCE_DIR}/app/clock_config_local.h")
    target_compile_definitions(Clock_Bootloader PRIVATE CLOCK_LOCAL_CONFIG=1)
endif()
target_link_options(Clock_Bootloader PRIVATE "-T${CMAKE_SOURCE_DIR}/bootloader/boot.ld"
    "-Wl,-Map=${CMAKE_CURRENT_BINARY_DIR}/Clock_Bootloader.map" -Wl,-z,noexecstack -nostartfiles)
set_property(TARGET Clock_Bootloader APPEND PROPERTY LINK_DEPENDS "${CMAKE_SOURCE_DIR}/bootloader/boot.ld")
add_custom_command(TARGET Clock_Bootloader POST_BUILD
    COMMAND ${CMAKE_OBJCOPY} -O ihex $<TARGET_FILE:Clock_Bootloader> ${CMAKE_CURRENT_BINARY_DIR}/Clock_Bootloader.hex
    COMMAND ${CMAKE_OBJCOPY} -O binary $<TARGET_FILE:Clock_Bootloader> ${CMAKE_CURRENT_BINARY_DIR}/Clock_Bootloader.bin
    VERBATIM)
