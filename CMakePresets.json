{
  "version": 3,
  "configurePresets": [
    {
      "name": "default",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "${sourceDir}/cmake/gcc-arm-none-eabi.cmake",
      "cacheVariables": {}
    },
    {
      "name": "Debug",
      "inherits": "default",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CLOCK_OTA_ENABLED": "OFF"
      }
    },
    {
      "name": "Release",
      "inherits": "default",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CLOCK_OTA_ENABLED": "OFF"
      }
    },
    {
      "name": "OtaDebug",
      "inherits": "default",
      "cacheVariables": {
        "CLOCK_OTA_ENABLED": "ON",
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "OtaRelease",
      "inherits": "default",
      "cacheVariables": {
        "CLOCK_OTA_ENABLED": "ON",
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "Debug",
      "configurePreset": "Debug"
    },
    {
      "name": "Release",
      "configurePreset": "Release"
    },
    {
      "name": "OtaDebug",
      "configurePreset": "OtaDebug"
    },
    {
      "name": "OtaRelease",
      "configurePreset": "OtaRelease"
    }
  ]
}
